<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>UGS File Launcher</title>
<link href="https://fonts.googleapis.com/css2?family=Share+Tech+Mono&family=Rajdhani:wght@400;600;700&display=swap" rel="stylesheet">
<style>
  :root {
    --bg: #0a0c10;
    --surface: #111318;
    --border: #1e2530;
    --accent: #00e5ff;
    --accent2: #ff3d71;
    --text: #c8d6e5;
    --muted: #4a5568;
    --green: #39ff14;
  }

  * { box-sizing: border-box; margin: 0; padding: 0; }

  body {
    background: var(--bg);
    color: var(--text);
    font-family: 'Rajdhani', sans-serif;
    min-height: 100vh;
    overflow-x: hidden;
  }

  body::before {
    content: '';
    position: fixed;
    inset: 0;
    background-image:
      linear-gradient(rgba(0,229,255,0.03) 1px, transparent 1px),
      linear-gradient(90deg, rgba(0,229,255,0.03) 1px, transparent 1px);
    background-size: 40px 40px;
    pointer-events: none;
    z-index: 0;
  }

  /* ── VIEWER OVERLAY ── */
  #viewer-overlay {
    display: none;
    position: fixed;
    inset: 0;
    z-index: 100;
    background: #000;
    flex-direction: column;
  }
  #viewer-overlay.open { display: flex; }

  #viewer-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 8px 14px;
    background: #0d1117;
    border-bottom: 1px solid var(--border);
    flex-shrink: 0;
  }

  #viewer-back {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--accent);
    background: none;
    border: 1px solid var(--accent);
    padding: 5px 12px;
    cursor: pointer;
    letter-spacing: 1px;
    transition: background 0.15s;
  }
  #viewer-back:hover { background: rgba(0,229,255,0.1); }

  #viewer-title {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--muted);
    flex: 1;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }

  #viewer-status {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    color: var(--muted);
  }

  #viewer-loading {
    display: none;
    position: absolute;
    inset: 0;
    top: 41px;
    background: #000;
    align-items: center;
    justify-content: center;
    flex-direction: column;
    gap: 16px;
    z-index: 10;
  }
  #viewer-loading.show { display: flex; }

  #viewer-loading .spinner {
    width: 32px; height: 32px;
    border: 3px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
  }

  #viewer-loading p {
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }

  #viewer-frame {
    flex: 1;
    width: 100%;
    border: none;
    background: #fff;
  }

  /* ── LAUNCHER ── */
  .container {
    position: relative;
    z-index: 1;
    max-width: 900px;
    margin: 0 auto;
    padding: 40px 24px 60px;
  }

  header {
    margin-bottom: 40px;
    border-left: 3px solid var(--accent);
    padding-left: 20px;
  }

  .eyebrow {
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 3px;
    text-transform: uppercase;
    margin-bottom: 8px;
  }

  h1 {
    font-size: clamp(28px, 5vw, 48px);
    font-weight: 700;
    letter-spacing: 2px;
    text-transform: uppercase;
    line-height: 1.1;
    color: #fff;
  }
  h1 span { color: var(--accent); }

  .subtitle {
    margin-top: 8px;
    font-size: 15px;
    color: var(--muted);
    font-family: 'Share Tech Mono', monospace;
  }

  .status-bar {
    display: flex;
    align-items: center;
    gap: 12px;
    margin-bottom: 32px;
    padding: 10px 16px;
    background: var(--surface);
    border: 1px solid var(--border);
    font-family: 'Share Tech Mono', monospace;
    font-size: 12px;
    color: var(--muted);
  }

  .status-dot {
    width: 8px; height: 8px;
    border-radius: 50%;
    background: var(--muted);
    flex-shrink: 0;
  }
  .status-dot.active { background: var(--green); animation: pulse 1.5s infinite; }
  .status-dot.error  { background: var(--accent2); }

  @keyframes pulse { 0%,100%{opacity:1} 50%{opacity:0.3} }
  @keyframes spin   { to{transform:rotate(360deg)} }

  #status-text { flex: 1; }
  .file-count  { color: var(--accent); }

  .search-wrap {
    position: relative;
    margin-bottom: 28px;
  }
  .search-wrap input {
    width: 100%;
    padding: 12px 16px 12px 44px;
    background: var(--surface);
    border: 1px solid var(--border);
    color: var(--text);
    font-family: 'Share Tech Mono', monospace;
    font-size: 13px;
    outline: none;
    transition: border-color 0.2s;
  }
  .search-wrap input:focus { border-color: var(--accent); }
  .search-wrap input::placeholder { color: var(--muted); }
  .search-icon {
    position: absolute;
    left: 14px; top: 50%;
    transform: translateY(-50%);
    color: var(--muted);
    font-size: 16px;
  }

  #file-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 12px;
  }

  .file-card {
    background: var(--surface);
    border: 1px solid var(--border);
    padding: 16px 18px;
    cursor: pointer;
    transition: border-color 0.15s, transform 0.15s, background 0.15s;
    display: flex;
    align-items: center;
    gap: 14px;
    position: relative;
    overflow: hidden;
    user-select: none;
  }
  .file-card::before {
    content: '';
    position: absolute;
    left: 0; top: 0;
    width: 3px; height: 0;
    background: var(--accent);
    transition: height 0.2s;
  }
  .file-card:hover {
    border-color: var(--accent);
    background: #131820;
    transform: translateX(2px);
  }
  .file-card:hover::before { height: 100%; }

  .file-icon {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    color: var(--accent);
    background: rgba(0,229,255,0.07);
    border: 1px solid rgba(0,229,255,0.2);
    padding: 4px 6px;
    flex-shrink: 0;
    letter-spacing: 1px;
  }

  .file-name {
    font-size: 14px;
    font-weight: 600;
    letter-spacing: 0.5px;
    color: #e0eaf5;
    word-break: break-word;
  }
  .file-ext {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    color: var(--muted);
    margin-top: 2px;
  }

  .launch-arrow {
    margin-left: auto;
    color: var(--muted);
    font-size: 18px;
    transition: color 0.15s, transform 0.15s;
    flex-shrink: 0;
  }
  .file-card:hover .launch-arrow { color: var(--accent); transform: translateX(3px); }

  .state-msg {
    grid-column: 1 / -1;
    padding: 48px 24px;
    text-align: center;
    font-family: 'Share Tech Mono', monospace;
    font-size: 13px;
    color: var(--muted);
    border: 1px dashed var(--border);
  }
  .state-msg.error-msg { color: var(--accent2); border-color: var(--accent2); }

  .spinner {
    display: inline-block;
    width: 16px; height: 16px;
    border: 2px solid var(--border);
    border-top-color: var(--accent);
    border-radius: 50%;
    animation: spin 0.7s linear infinite;
    margin-right: 10px;
    vertical-align: middle;
  }

  footer {
    margin-top: 48px;
    padding-top: 20px;
    border-top: 1px solid var(--border);
    font-family: 'Share Tech Mono', monospace;
    font-size: 11px;
    color: var(--muted);
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 8px;
  }
  footer a { color: var(--accent); text-decoration: none; }
  footer a:hover { text-decoration: underline; }

  .cdn-badge {
    font-family: 'Share Tech Mono', monospace;
    font-size: 10px;
    padding: 2px 6px;
    background: rgba(57,255,20,0.08);
    border: 1px solid rgba(57,255,20,0.25);
    color: var(--green);
    letter-spacing: 1px;
    margin-left: 8px;
  }
</style>
</head>
<body>

<!-- ── FULL-SCREEN VIEWER ── -->
<div id="viewer-overlay">
  <div id="viewer-bar">
    <button id="viewer-back" onclick="closeViewer()">← BACK</button>
    <span id="viewer-title">—</span>
    <span id="viewer-status"></span>
  </div>
  <div id="viewer-loading">
    <div class="spinner"></div>
    <p id="viewer-loading-msg">Fetching file…</p>
  </div>
  <iframe id="viewer-frame" sandbox="allow-scripts allow-same-origin allow-forms allow-modals allow-popups"></iframe>
</div>

<!-- ── LAUNCHER ── -->
<div class="container" id="launcher">
  <header>
    <div class="eyebrow">arcimiedies / nothing-to-see-here</div>
    <h1>UGS <span>File</span> Launcher</h1>
    <div class="subtitle">// UGS-Files directory <span class="cdn-badge">jsdelivr → unpkg</span></div>
  </header>

  <div class="status-bar">
    <div class="status-dot" id="status-dot"></div>
    <span id="status-text">Connecting to GitHub API…</span>
    <span class="file-count" id="file-count"></span>
  </div>

  <div class="search-wrap">
    <span class="search-icon">⌕</span>
    <input type="text" id="search" placeholder="filter files..." oninput="filterFiles()" />
  </div>

  <div id="file-grid">
    <div class="state-msg"><span class="spinner"></span>Loading files from GitHub…</div>
  </div>

  <footer>
    <span>Source: <a href="https://github.com/arcimiedies/nothing-to-see-here/tree/main/UGS-Files" target="_blank">github.com/arcimiedies/nothing-to-see-here</a></span>
    <span>jsdelivr.net → unpkg.com (on-the-fly rewrite)</span>
  </footer>
</div>

<script>
// ── CONFIG ──────────────────────────────────────────────────────────────────
const REPO   = 'arcimiedies/nothing-to-see-here';
const FOLDER = 'UGS-Files';
const API_URL = `https://api.github.com/repos/${REPO}/contents/${FOLDER}`;

// ── CDN REWRITE ──────────────────────────────────────────────────────────────
// Converts any jsdelivr URL to its unpkg equivalent.
// Handles both formats:
//   https://cdn.jsdelivr.net/npm/PACKAGE@VERSION/file
//   https://cdn.jsdelivr.net/gh/USER/REPO@REF/file  (GitHub-hosted, use raw.githubusercontent)
function rewriteCDN(html) {
  return html.replace(
    /https?:\/\/cdn\.jsdelivr\.net\/npm\/((?:[^"'\s>])+)/g,
    (_, rest) => `https://unpkg.com/${rest}`
  ).replace(
    /https?:\/\/cdn\.jsdelivr\.net\/gh\/([^/@"'\s>]+)\/([^/@"'\s>]+)@?([^/"'\s>]*)\/([^"'\s>]*)/g,
    (_, user, repo, ref, path) => {
      const branch = ref || 'main';
      return `https://raw.githubusercontent.com/${user}/${repo}/${branch}/${path}`;
    }
  );
}

// ── VIEWER ───────────────────────────────────────────────────────────────────
async function openFile(rawUrl, name) {
  const overlay  = document.getElementById('viewer-overlay');
  const loading  = document.getElementById('viewer-loading');
  const loadMsg  = document.getElementById('viewer-loading-msg');
  const frame    = document.getElementById('viewer-frame');
  const title    = document.getElementById('viewer-title');
  const status   = document.getElementById('viewer-status');

  overlay.classList.add('open');
  loading.classList.add('show');
  frame.srcdoc = '';
  title.textContent  = name;
  status.textContent = '';

  try {
    loadMsg.textContent = 'Fetching file…';
    const res = await fetch(rawUrl);
    if (!res.ok) throw new Error(`HTTP ${res.status}`);

    loadMsg.textContent = 'Rewriting CDN links…';
    const original = await res.text();
    const rewritten = rewriteCDN(original);

    const replaced = (original.match(/cdn\.jsdelivr\.net/g) || []).length;
    status.textContent = replaced
      ? `✓ ${replaced} jsdelivr link${replaced !== 1 ? 's' : ''} rewritten → unpkg`
      : '✓ no jsdelivr links found';

    loadMsg.textContent = 'Rendering…';
    frame.srcdoc = rewritten;
    loading.classList.remove('show');

  } catch (err) {
    loading.classList.remove('show');
    frame.srcdoc = `<html><body style="background:#0a0c10;color:#ff3d71;font-family:monospace;padding:40px">
      <h2>Failed to load file</h2><p>${err.message}</p>
      <p style="color:#4a5568;margin-top:16px">The file may be too large to fetch, or GitHub rate-limited the request.</p>
    </body></html>`;
  }
}

function closeViewer() {
  const overlay = document.getElementById('viewer-overlay');
  const frame   = document.getElementById('viewer-frame');
  overlay.classList.remove('open');
  frame.srcdoc = '';
}

// Close viewer with Escape key
document.addEventListener('keydown', e => {
  if (e.key === 'Escape') closeViewer();
});

// ── FILE LISTING ─────────────────────────────────────────────────────────────
let allFiles = [];

async function loadFiles() {
  const dot      = document.getElementById('status-dot');
  const statusEl = document.getElementById('status-text');
  const countEl  = document.getElementById('file-count');
  const grid     = document.getElementById('file-grid');

  try {
    const res = await fetch(API_URL);
    if (!res.ok) throw new Error(`GitHub API returned ${res.status}`);
    const data = await res.json();

    allFiles = data.filter(f => f.type === 'file');

    if (allFiles.length === 0) {
      dot.className = 'status-dot error';
      statusEl.textContent = 'No files found in UGS-Files folder.';
      grid.innerHTML = '<div class="state-msg error-msg">No files found.</div>';
      return;
    }

    dot.className    = 'status-dot active';
    statusEl.textContent = 'Loaded successfully';
    countEl.textContent  = `${allFiles.length} file${allFiles.length !== 1 ? 's' : ''}`;
    renderFiles(allFiles);

  } catch (err) {
    dot.className = 'status-dot error';
    statusEl.textContent = 'Failed to fetch from GitHub API';
    grid.innerHTML = `<div class="state-msg error-msg">Error: ${err.message}<br><br>GitHub API may be rate-limited. Try again shortly.</div>`;
  }
}

function getExt(name) {
  const parts = name.split('.');
  return parts.length > 1 ? parts.pop().toUpperCase() : 'FILE';
}

function getBaseName(name) {
  const parts = name.split('.');
  if (parts.length > 1) parts.pop();
  return parts.join('.');
}

function renderFiles(files) {
  const grid = document.getElementById('file-grid');
  if (files.length === 0) {
    grid.innerHTML = '<div class="state-msg">No files match your search.</div>';
    return;
  }

  grid.innerHTML = files.map(f => {
    const ext    = getExt(f.name);
    const base   = getBaseName(f.name);
    const rawUrl = f.download_url ||
      `https://raw.githubusercontent.com/${REPO}/main/${FOLDER}/${encodeURIComponent(f.name)}`;
    return `
      <div class="file-card" onclick="openFile('${rawUrl}', '${f.name.replace(/'/g,"\\'")}')">
        <div class="file-icon">${ext}</div>
        <div>
          <div class="file-name">${base}</div>
          <div class="file-ext">.${ext.toLowerCase()}</div>
        </div>
        <span class="launch-arrow">→</span>
      </div>`;
  }).join('');
}

function filterFiles() {
  const q = document.getElementById('search').value.toLowerCase().trim();
  const filtered = q ? allFiles.filter(f => f.name.toLowerCase().includes(q)) : allFiles;
  renderFiles(filtered);
}

loadFiles();
</script>
</body>
</html>
